# Copy to .env.local to override. Everything here has a sensible default.

# "local" (default) runs the whole backend inside the browser in a Web Worker.
# `vite build` always uses "convex" (see .env.production).
# VITE_BACKEND=local

# Simulated round-trip latency for the local backend, in milliseconds.
# VITE_FAKE_LATENCY_MS=120

# Written automatically by `npx convex dev` -- do not fill these in by hand.
# CONVEX_DEPLOYMENT=dev:your-deployment-name
# VITE_CONVEX_URL=https://your-deployment-name.convex.cloud

# The keys below live on the Convex DEPLOYMENT, not in this file:
#   npx convex env set OPENAI_API_KEY sk-...          bot brains + rival personas
#   npx convex env set FIRECRAWL_API_KEY fc-...       summon a rival from a link (required at deploy time)
#   npx convex env set AGENTMAIL_API_KEY ...          the arena inbox
#   npx convex env set AGENTMAIL_WEBHOOK_SECRET ...   inbound mail verification
#   npx convex env set AGENTMAIL_INBOX circleback@agentmail.to
# See docs/DEPLOYING.md.
